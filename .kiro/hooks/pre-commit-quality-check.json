{
    "name": "Pre-Commit Quality Check",
    "version": "1.0.0",
    "description": "Run quality gates before commit",
    "when": {
        "type": "userTriggered"
    },
    "then": {
        "type": "runCommand",
        "command": "uv run ruff format src/ && uv run ruff check src/ && uv run ty check src/",
        "timeout": 120
    }
}
