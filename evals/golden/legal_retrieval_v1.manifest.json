    "synthetic_requires": ["synthetic_owned", "not_required_or_verified_terms"],
    "unknown_or_forbidden_provenance": "ci_failure"
  },
  "annotation_policy": {
    "retrieval_relevance_role": "engineer",
    "claim_entailment_role": "legal_sme",
    "double_label_adjudication": "optional"
  }
}
