{
  "manifest_version": "golden_provenance_v1",
  "golden_set_version": "legal_retrieval_v1",
  "artifact": "legal_retrieval_v1.jsonl",
  "source_policy": {
    "allowed_source_types": ["public", "synthetic", "client"],
    "client_requires": ["written_permission", "verified_license_terms"],
