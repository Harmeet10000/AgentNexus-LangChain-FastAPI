{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/AGENTS.md",
    ".opencode/instructions/PROJECT-SNAPSHOT.md",
    ".opencode/instructions/TOOLING-COMMANDS.md",
    ".opencode/instructions/ARCHITECTURE-RULES.md",
    ".opencode/instructions/PYTHON-TYPING-RULES.md",
    ".opencode/instructions/RESULT-PATTERN.md",
    ".opencode/instructions/REFERENCE-MAP.md"
  ],
  "references": {
    "docs": {
      "path": "docs",
      "description": "Use for product behavior, architecture decisions, and domain documentation conventions"
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills",
      ".github/skills",
      "/home/harmeet/Desktop/prompts/skills"
    ]
  },
  "tools": {
    "skill": false
  },
  "agent": {},
  "command": {},
  "plugin": [
    ".opencode/plugins/graphify.js",
    "@warp-dot-dev/opencode-warp@0.1.5",
    "@mohak34/opencode-notifier@latest",
    "@zenobius/opencode-skillful",
    "opencode-scheduler",
    "@lyculs/opencode-firecrawl",
    "opencode-handoff",
    "opencode-ponytail"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "uv *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "ty *": "allow",
      "git *": "allow",
      "graphify *": "allow",
      "rm -rf *": "ask",
      "git reset --hard *": "ask",
      "grep *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "cd *": "allow",
      "pwd": "allow",
      "python3 *": "allow",
      "python -c *": "allow",
      "rg *": "allow",
      "Select-String *": "allow",
      "Test-Path *": "allow",
      "Get-ChildItem *": "allow",
      "Get-Command *": "allow",
      "openspec *": "allow",
      "New-Item *": "allow",
      "findstr *": "allow"
    },
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "webfetch": "allow"
  },
  "compaction": {
    "auto": true,
  }
}